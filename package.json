{
  "name": "course-grading-assist",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"tsx watch src/server/index.ts\"",
    "setup": "tsx scripts/setup-env.ts",
    "dev:client": "vite",
    "dev:server": "tsx watch src/server/index.ts",
    "start": "tsx src/server/index.ts",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "db:migrate": "tsx src/server/migrate.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.1.0",
    "cors": "2.8.6",
    "csv-parse": "7.0.2",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "mammoth": "1.12.1",
    "multer": "2.2.0",
    "pdf-parse": "2.4.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/multer": "2.2.0",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "concurrently": "10.0.5",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vite": "8.2.1"
  }
}
