# Keep real values only in .env; never commit or paste them into chat.
# Optional. Leave empty to run rubric capture/extraction/grading without persistence.
DATABASE_URL=
# Required by roster import and the pseudonym endpoints; use at least 32 random characters.
STUDENT_IDENTITY_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b-instruct
# Local grading timeout in milliseconds (30000-1800000, default: 20 minutes).
OLLAMA_TIMEOUT_MS=1200000
# Grading context window in tokens (8192-131072, default 16384, roughly a 10-page paper).
# Larger values grade longer papers but use more memory and run slower.
OLLAMA_GRADING_NUM_CTX=16384
# Character budget (0-20000, default 3000) for the selected student's prior saved
# feedback injected into the grading prompt. 0 disables injection entirely.
# Claude receives twice this budget; the feedback is never shown in the UI.
PRIOR_FEEDBACK_MAX_CHARS=3000
# Grading backend: "ollama" (local, default) or "claude" (Anthropic cloud).
# Set to "claude" and supply ANTHROPIC_API_KEY to use Claude Haiku.
GRADING_BACKEND=ollama
# Required when GRADING_BACKEND=claude. Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=
# Claude model to use (default: claude-haiku-4-5).
ANTHROPIC_MODEL=claude-haiku-4-5
LIBREOFFICE_PATH=C:\Program Files\LibreOffice\program\soffice.com
PORT=8787
JSON_LIMIT=1mb
# How often expired courses are purged, in milliseconds (60000-86400000, default 6 hours).
RETENTION_INTERVAL_MS=21600000
# Attempts per purge sweep (1-10, default 3). Sleep/resume drops the database
# connection, so the first attempt after a resume often fails on transport alone.
RETENTION_RETRY_ATTEMPTS=3
# Base backoff between those attempts, in milliseconds (1000-600000, default 5000).
# Multiplied by the attempt number, so 5000 gives 5s then 10s.
RETENTION_RETRY_BACKOFF_MS=5000
# After a sweep fails every attempt, retry once after this delay in milliseconds
# (60000-21600000, default 15 minutes) instead of waiting a full interval.
RETENTION_RECOVERY_DELAY_MS=900000
