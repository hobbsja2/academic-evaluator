# Keep real values only in .env; never commit or paste them into chat.
# Optional. Leave empty to run rubric capture/extraction/grading without persistence.
DATABASE_URL=
# Required only by roster pseudonym endpoints; use at least 32 random characters.
STUDENT_IDENTITY_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b-instruct
# Local grading timeout in milliseconds (30000-1800000, default: 20 minutes).
OLLAMA_TIMEOUT_MS=1200000
# Grading context window in tokens (8192-131072, default 16384, roughly a 10-page paper).
# Larger values grade longer papers but use more memory and run slower.
OLLAMA_GRADING_NUM_CTX=16384
# Grading backend: "ollama" (local, default) or "claude" (Anthropic cloud).
# Set to "claude" and supply ANTHROPIC_API_KEY to use Claude Haiku.
GRADING_BACKEND=ollama
# Required when GRADING_BACKEND=claude. Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=
# Claude model to use (default: claude-haiku-4-5).
ANTHROPIC_MODEL=claude-haiku-4-5
LIBREOFFICE_PATH=C:\Program Files\LibreOffice\program\soffice.com
PORT=8787
JSON_LIMIT=1mb
